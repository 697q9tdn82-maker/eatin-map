{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "eatin-map",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "eatin-map" }
  ],
  "kv_namespaces": [
    // ページの作り置きの保存先。移行時に `npx wrangler kv namespace create NEXT_INC_CACHE_KV` で作り、表示されたidをここに入れる
    { "binding": "NEXT_INC_CACHE_KV", "id": "REPLACE_WITH_KV_ID" }
  ]
}
