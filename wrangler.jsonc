{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "eatin-map",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "eatin-map" }
  ],
  "kv_namespaces": [
    // ページの作り置きの保存先（Cloudflareの Workers KV「eatin-map-cache」）
    { "binding": "NEXT_INC_CACHE_KV", "id": "55f0654b5d4e430ab3884c501b91441f" }
  ]
}
